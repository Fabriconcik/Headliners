{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Запустить игру (1-Click)",
      "type": "shell",
      "command": "cmd.exe",
      "args": ["/c", "start.bat"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Запустить сервер (npm.cmd start)",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["start"],
      "problemMatcher": []
    },
    {
      "label": "Режим разработки (npm.cmd run dev)",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "problemMatcher": []
    },
    {
      "label": "Собрать проект (npm.cmd run build)",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "problemMatcher": []
    }
  ]
}
